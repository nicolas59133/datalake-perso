# Copie ce fichier en .env et remplis. Le .env n'est PAS versionné.

# Lake DuckDB (défaut : ./data/datalake.duckdb)
# DUCKDB_PATH=./data/datalake.duckdb

# Météo (défaut : Lille)
# LATITUDE=50.6292
# LONGITUDE=3.0573
# WEATHER_START_DATE=2018-01-01

# --- Withings (obligatoire pour la source Withings) ---
WITHINGS_CLIENT_ID=colle_ton_client_id_ici
WITHINGS_CLIENT_SECRET=colle_ton_client_secret_ici
WITHINGS_REDIRECT_URI=http://localhost:3000

# Apple Health : pas de clés, juste un fichier à déposer. Voir APPLE_HEALTH.md.
# APPLE_HEALTH_EXPORT_PATH=./data/apple_health_export/export.xml

# --- Google Health / Fitbit Air (obligatoire pour cette source) ---
# Voir GOOGLE_HEALTH.md pour créer le client OAuth (Google Cloud Console).
GOOGLE_HEALTH_CLIENT_ID=colle_ton_client_id_ici
GOOGLE_HEALTH_CLIENT_SECRET=colle_ton_client_secret_ici
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000
